# depangram's keys and machine settings. Copy this file to .env and fill in what you use; git ignores .env.
# A setting in .env wins over the same name in the environment. Leave a line empty to take its default.

# ---------------------------------------------------------------- keys
# Pangram's API key, for scoring (the only paid detector the engine calls)
PANGRAM_API_KEY=
# the Claude Code CLI's subscription token, made with `claude setup-token` (CLAUDE_BACKEND=cli)
CLAUDE_CODE_OAUTH_TOKEN=
# an Anthropic API key (CLAUDE_BACKEND=api); the CLI backend strips it from the CLI's environment
ANTHROPIC_API_KEY=
# Discord: a webhook URL for one-way posts
DISCORD_WEBHOOK_URL=
# Discord: a bot token and a channel id for two-way posts (questions and your answers)
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=
# Discord: your user id, so only your replies count as answers (unset: anybody who isn't a bot)
DISCORD_AUTHOR_ID=
# Modal and Hugging Face, for the adapter training in training/
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
HF_TOKEN=

# ---------------------------------------------------------------- choices
# cli (the default) or api: how Claude is called
CLAUDE_BACKEND=
# discord (the default), file or none: where posts and digests go
NOTIFIER=
# the Claude Code CLI's command (default: claude, from the PATH)
CLAUDE_CLI=
# Pangram's model and API address (defaults: pangram-4.1 and Pangram's own address)
PANGRAM_MODEL=
PANGRAM_BASE_URL=
# the prefix of the Modal app and volume names (default: depangram)
MODAL_PREFIX=

# ---------------------------------------------------------------- paths (each has a default)
# run logs, the SQLite ledger and the queues (default: runs/ in the repo)
RUNS_DIR=
# the folder the Claude CLI runs in; keep it outside any repo (default: ~/.depangram/work)
WORK_DIR=
# the GGUF model files (default: models/ in the repo)
MODELS_DIR=
# the model registry (default: models.toml in the repo)
MODELS_FILE=
# a folder holding llama.cpp's llama-server (default: llama.cpp/ in the repo, else the PATH)
LLAMA_CPP_DIR=
# the Open Pangram (EditLens) model files (default: open-pangram/ in MODELS_DIR)
OPEN_PANGRAM_DIR=
# a file whose presence stops the loop and the night (default: STOP in RUNS_DIR)
STOP_FILE=
# where NOTIFIER=file writes (default: notifications/ in RUNS_DIR)
NOTIFY_DIR=
# the AI-tells scanner folder (default: engine/tics/ in the repo when it's there)
TICS_DIR=
# the house rules file (default: rules.toml in the repo)
RULES_FILE=

# ---------------------------------------------------------------- your writing (optional, unset by default)
# your writing samples ("## Sample N" headings; engine/tics/voice_audit.py says more)
SAMPLES_FILE=
# samples for the swear budget, AI-assisted ones tagged (the same file as SAMPLES_FILE works)
SAMPLES_TAGGED=
# where the voice baseline built from SAMPLES_FILE is cached (default: next to the samples file)
VOICE_BASELINE=
# your voice guide (markdown), for the restore pass's careful prompt
VOICE_GUIDE=
# a folder of your own writing (.txt, .md, or comments.jsonl and posts.jsonl), for the idiom list
IDIOMS_DIR=
# folders of chat transcripts (*.jsonl), separated by the system's path separator, for find_lines
CHAT_LOG_DIRS=
# a folder of chat exports (*.md), for find_lines
CHAT_HISTORY_DIR=

# another config file instead of config.toml. Read from the environment only, so set it in your shell or
# scheduler, not here: DEPANGRAM_CONFIG

# ---------------------------------------------------------------- the scheduler examples
# the Python the scheduled night runs with (default: the venv in the repo). night task.ps1 reads it from the
# environment only, not from this file, so set it in your shell or pass -Python
DEPANGRAM_PYTHON=
